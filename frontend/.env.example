# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) environment — copy to frontend/.env and edit.
#
# Only VITE_-prefixed vars are exposed to the browser bundle. Vite reads this
# file at dev-server start (restart after changes). Every var below is optional
# in development — the in-code defaults (shown in comments) are used if unset.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=                        # backend API base; dev default http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_BILLING_ENABLED=0               # 1 to show Pro / billing UI
VITE_SITE_DOMAIN=                    # default "sciencebo.uk"; also derives the prod API host (api.<domain>)
VITE_GITHUB_URL=                     # default https://github.com/alikatgh/sciencebouk
VITE_SUPPORT_EMAIL=                  # default hi@alik.asia
