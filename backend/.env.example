# ─────────────────────────────────────────────────────────────────────────────
# Backend (Django) environment — copy to backend/.env and edit.
#
# settings.py loads backend/.env FIRST, then the repo-root .env, keeping the
# FIRST occurrence of each key — so values here OVERRIDE the root .env. This
# file is the authoritative list of every variable the backend reads.
#
# For local dev you usually only need DJANGO_DEBUG=1; everything else has a
# safe development default. Variables marked (prod) are required/recommended
# only when DJANGO_DEBUG=0.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
DJANGO_DEBUG=1                       # 1 = dev (SQLite, dev secret, prod guards off); 0 = production
DJANGO_SECRET_KEY=                   # (prod) REQUIRED when DEBUG=0; a dev key is used if unset
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PATH=admin              # (prod) move the admin off the obvious /admin/ path
DATABASE_URL=                        # empty = SQLite (dev); postgres://user:pass@host:5432/db (prod)
FRONTEND_URL=http://localhost:5173   # backend var (redirects/links); (prod) must not be a localhost URL

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth / Google OAuth ──────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=          # only needed for the OAuth code flow (not the GIS ID-token flow)
DJANGO_INVITES_REQUIRED=1            # 1 = signup requires a valid invite code
JWT_ACCESS_LIFETIME_SECONDS=         # optional override (default set in settings.py)
JWT_REFRESH_LIFETIME_SECONDS=        # optional override (default set in settings.py)
DJANGO_AUTH_RATE=                    # optional throttle for auth endpoints, e.g. 5/min
DJANGO_ANON_PROGRESS_RATE=           # optional throttle for anonymous progress, e.g. 60/min

# ── Billing / Stripe ─────────────────────────────────────────────────────────
DJANGO_BILLING_ENABLED=0             # 1 to enable Stripe checkout/webhook endpoints
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=                 # optional legacy single-price fallback

# ── Tuning (optional) ────────────────────────────────────────────────────────
DJANGO_PAGE_SIZE=20                  # DRF default page size
DJANGO_SERVE_MEDIA=0                 # 1 to serve user media through Django (always on when DEBUG=1)
DJANGO_CACHE_BACKEND=                # e.g. django.core.cache.backends.redis.RedisCache; default LocMem
DJANGO_CACHE_LOCATION=               # cache location/URL when a non-default backend is set
DJANGO_SECURE_HSTS_SECONDS=          # (prod) HSTS max-age, e.g. 31536000
