# Host blocks for the shared Hetzner Caddyfile; preserve other applications.
sciencebo.uk {
    encode zstd gzip
    @backend path /api/* /admin/* /static/*
    @cloudflare {
        remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        header CF-Connecting-IP *
    }
    handle @backend {
        handle @cloudflare {
        reverse_proxy 127.0.0.1:8015 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
        }
        handle {
            reverse_proxy 127.0.0.1:8015
        }
    }
    # Hashed Vite chunks must 404 when missing. SPA-fallback to index.html
    # makes the browser try to import HTML as a module after a deploy.
    @hashed path /assets/*
    handle @hashed {
        root * /var/www/sciencebouk
        file_server
    }
    handle {
        root * /var/www/sciencebouk
        try_files {path}/index.html {path} /index.html
        file_server
        header Cache-Control "no-cache"
        header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.sciencebo.uk https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    }
    header Strict-Transport-Security "max-age=31536000"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Referrer-Policy "strict-origin-when-cross-origin"
}

www.sciencebo.uk {
    redir https://sciencebo.uk{uri} permanent
}

api.sciencebo.uk {
    encode zstd gzip
    @cloudflare {
        remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        header CF-Connecting-IP *
    }
    handle @cloudflare {
        reverse_proxy 127.0.0.1:8015 {
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8015
    }
    header Strict-Transport-Security "max-age=31536000"
}

